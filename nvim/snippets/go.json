      "for ${1:_, v} := range ${2:items} {",
      "\twg.Add(1)",
      "\tgo func() {",
      "\t\tdefer wg.Done()",
      "\t\t${0}",
      "\t}()",
      "}",
      "wg.Wait()"
    ],
    "description": "sync.WaitGroup over a range"
  },
  "errgroup": {
    "prefix": [
      "errgroup"
    ],
    "body": [
      "g, ctx := errgroup.WithContext(${1:ctx})",
      "g.Go(func() error {",
      "\t${0}",
      "\treturn nil",
      "})",
      "if err := g.Wait(); err != nil {",
      "\treturn err",
      "}"
    ],
    "description": "errgroup"
  },
