      "\t${0}",
      "})"
    ],
    "description": "t.Run"
  },
  "table test": {
    "prefix": [
      "testtable"
    ],
    "body": [
      "func Test${1:Name}(t *testing.T) {",
      "\ttests := []struct {",
      "\t\tname string",
      "\t\t${2:in}   ${3:string}",
      "\t\twant ${4:string}",
      "\t}{",
      "\t\t{name: \"${5:case}\", $2: ${6:\"\"}, want: ${7:\"\"}},",
      "\t}",
      "\tfor _, tt := range tests {",
      "\t\tt.Run(tt.name, func(t *testing.T) {",
      "\t\t\tgot := ${8:fn}(tt.$2)",
      "\t\t\tif got != tt.want {",
      "\t\t\t\tt.Errorf(\"got %v, want %v\", got, tt.want)",
      "\t\t\t}",
      "\t\t})",
      "\t}",
      "}"
    ],
    "description": "table-driven test with subtests"
  },
  "test helper": {
    "prefix": [
      "testhelper"
    ],
    "body": [
      "func ${1:helper}(t *testing.T${2}) {",
      "\tt.Helper()",
      "\t${0}",
      "}"
    ],
    "description": "test helper (t.Helper)"
  },
  "http handler json": {
    "prefix": [
      "httphandlerjson"
    ],
    "body": [
      "func (${1:h} *${2:Handler}) ${3:Get}(w http.ResponseWriter, r *http.Request) {",
      "\tw.Header().Set(\"Content-Type\", \"application/json\")",
      "\tif err := json.NewEncoder(w).Encode(${4:resp}); err != nil {",
      "\t\thttp.Error(w, err.Error(), http.StatusInternalServerError)",
      "\t}",
      "}"
    ],
    "description": "HTTP handler that responds with JSON"
  },
  "json decode body": {
    "prefix": [
      "jsondecodebody"
    ],
    "body": [
      "var ${1:req} ${2:Request}",
      "if err := json.NewDecoder(r.Body).Decode(&$1); err != nil {",
      "\thttp.Error(w, err.Error(), http.StatusBadRequest)",
      "\treturn",
      "}"
    ],
    "description": "decode the JSON request body"
  },
